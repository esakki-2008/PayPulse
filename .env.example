# Server-side PayPal Sandbox configuration.
# Copy this file to .env.local and populate it locally. Never commit .env.local.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Optional fixed server-only Sandbox checkout fixture. These values are used
# only by the explicit merchant-approved verification action; browser input
# cannot select an amount, currency, or redirect. Keep the URLs local/HTTPS.
PAYPAL_SANDBOX_ORDER_AMOUNT=
PAYPAL_SANDBOX_ORDER_CURRENCY=
PAYPAL_SANDBOX_RETURN_URL=
PAYPAL_SANDBOX_CANCEL_URL=
# Explicit local test opt-in only; never enable in shared/production environments.
PAYPAL_SANDBOX_ENABLE_WRITE_TEST=false
# Set only after manually approving the named known Sandbox order, then run the
# opt-in capture integration test. Leave blank otherwise.
PAYPAL_SANDBOX_APPROVED_ORDER_ID=
PAYPAL_SANDBOX_ENABLE_CAPTURE_TEST=false

# Durable PostgreSQL persistence. Required in production; do not place this in client code.
DATABASE_URL=
# Local-only explicit memory opt-in. Never works in production.
PAYPULSE_PERSISTENCE=memory

# Authentication is fail-closed. Local development requires both explicit mode
# and a server-only access token. Development sessions never work in production.
PAYPULSE_AUTH_MODE=development
PAYPULSE_DEV_AUTH_TOKEN=
PAYPULSE_DEV_ACTOR_ID=
PAYPULSE_DEV_MERCHANT_ID=
PAYPULSE_DEV_AUTH_ROLE=owner

# Production identity: set PAYPULSE_AUTH_MODE=external and configure a Clerk
# instance. Both values are required server-side for readiness; never commit
# actual values. The publishable key is intentionally named for Next.js client
# delivery, while the secret key must remain server-only.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk Organization is mandatory: its verified active Organization ID becomes
# the PayPulse merchant ID. Role mapping is restrictive: org:admin -> owner,
# org:operator -> operator (configure this custom Clerk Organization role), and
# org:member or any unknown role -> viewer.

# Optional server-only AI explanation. Leave disabled to return deterministic
# intelligence and an explicit "AI explanation temporarily unavailable" state.
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=
